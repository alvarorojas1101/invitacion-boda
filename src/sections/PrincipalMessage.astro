---
import Divider from "@/components/Divider.astro";
import Title from "@/components/Title.astro";
---

<section>
  <div
    class="max-w-[1140px] phone:w-full phone:px-2 mx-auto mb-12 mt-12 desktop:mb-14 desktop:mt-24 text-color01 flex gap-3 justify-center items-center flex-col">
    <Title title="Alvaro & Jersy" />
    <p
      class="font-rubik desktop:text-xl text-center font-extralight text-gray-400">
      <br />
      Con la bendición de nuestros padres, Alvaro Rojas & Jersy Camperos,<br />
      tenemos el honor de invitarlos a celebrar la unión de nuestras vidas en matrimonio
      civil.<br />
      Viernes 6 de junio de 2025.
    </p>
  </div>
  <Divider />
  <img src="/heard-message.gif" class="w-28 mx-auto" title="gif de corazón" />
</section>
