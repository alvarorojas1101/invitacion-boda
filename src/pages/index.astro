---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/sections/Hero.astro";
import Countdown from "@/sections/Countdown.astro";
import PrincipalDate from "@/sections/PrincipalDate.astro";
import Message from "@/sections/Message.astro";
import Party from "@/sections/Party.astro";
import Instagram from "@/sections/Instagram.astro";
import Footer from "@/sections/Footer.astro";
import VideoSection from "@/sections/VideoSection.astro";
import PrincipalMessage from "@/sections/PrincipalMessage.astro";
---

<Layout title="Boda de Alvaro & Jersy">
  <div id="hero" class="hidden">
    <Hero />
    <VideoSection src="/videos/inicio.webm" height="100vh" />
    <PrincipalMessage />
    <section class="p-4">
      <Countdown />
      <PrincipalDate />
      <Message />
      <Party />
      <VideoSection src="/videos/momento.webm" height="90vh" />
      <Instagram />
      <Footer />
    </section>
  </div>
</Layout>
